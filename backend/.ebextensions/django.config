option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: config.settings
    PYTHONPATH: /var/app/current/backend
  aws:elasticbeanstalk:container:python:
    WSGIPath: config.wsgi:application

container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && cd /var/app/current/backend && python manage.py migrate --noinput"
    leader_only: true
  02_ensure_admin:
    command: "source /var/app/venv/*/bin/activate && cd /var/app/current/backend && python manage.py shell -c \"from django.contrib.auth.models import User; u=User.objects.filter(username='admin').first(); u.set_password('TechTrolley2026!'); u.is_staff=True; u.is_superuser=True; u.save() if u else User.objects.create_superuser('admin', 'admin@amaudiovisuals.in', 'TechTrolley2026!')\""
    leader_only: true
