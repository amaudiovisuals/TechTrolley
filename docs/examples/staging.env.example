# Template only. No secrets. Do not source this example into a real service.
# Store actual values in a private environment file outside the repository.
DJANGO_ENV=staging
DJANGO_SECRET_KEY=REPLACE_ME_WITH_A_NEW_PRIVATE_RANDOM_VALUE_OF_AT_LEAST_50_CHARACTERS
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=staging.example.test
TT_APP_ORIGIN=https://staging.example.test
TT_INSTANCE_ID=staging-unique-instance
TT_DB_NAME=techtrolley_staging
TT_DB_USER=techtrolley_staging_role
TT_DB_PASSWORD=REPLACE_ME_WITH_A_PRIVATE_DATABASE_PASSWORD
TT_DB_HOST=127.0.0.1
TT_DB_PORT=5432
TT_MEDIA_ROOT=/srv/techtrolley-staging/private-media
TT_STATIC_ROOT=/srv/techtrolley-staging/static
TT_EXTERNAL_AI_ENABLED=false
REVIEWED_RECONCILIATION_WRITES_ENABLED=false
REVIEWED_OWNERSHIP_WRITES_ENABLED=false
# Leave proxy trust disabled unless the reviewed proxy strips and sets the header
# and clients cannot reach the application socket directly.
TT_TRUST_PROXY=false
TT_PROXY_HEADER_SANITIZED=false
# Only for the reviewed private Unix socket; never for a public/TCP app listener.
TT_PROXY_CLIENT_IP_FROM_UNIX=false
# Remote PostgreSQL also requires verify-full and an absolute trusted CA path.
# TT_DB_SSLMODE=verify-full
# TT_DB_SSLROOTCERT=/etc/techtrolley/postgresql-ca.crt
